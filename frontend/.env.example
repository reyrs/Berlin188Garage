# SUPABASE: Database & Auth
# Create a project at https://supabase.com, then copy the URL and anon key.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# GOOGLE ANALYTICS (GA4): Optional. Leave blank to disable — analytics.ts
# no-ops without it. Create a GA4 property at https://analytics.google.com,
# then copy the Measurement ID (format G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=""
